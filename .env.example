# ==============================================================================================
# SITESENTINEL MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================================
# This project enforces a strict security & architectural boundary between Backend and Frontend.
#
# 1. BACKEND VARIABLES (server/):
#    - Processed exclusively by the Node.js/Express server runtime.
#    - Contain sensitive credentials (GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY).
#    - NEVER bundled into or accessible by the browser client.
#
# 2. FRONTEND VARIABLES (client/):
#    - Must begin with the `VITE_` prefix.
#    - Baked directly into the public JavaScript client bundle during compilation.
#    - Must NEVER contain secrets, private tokens, or administrative keys.
# ==============================================================================================

# ==============================================================================================
# 🔵 BACKEND SERVER ONLY (server/) — PRIVATE & SENSITIVE
# ==============================================================================================
PORT=5000                              # Port Express listens on
NODE_ENV=development                   # Environment: development | production | test
CLIENT_URL=http://localhost:5173       # Strict CORS allowed origin

# --- Persistence & Data Mode ---
# "local"    => Zero-config demo mode (local JSON store, local uploads, zero external dependencies)
# "supabase" => Enterprise cloud PostgreSQL with Row Level Security (RLS) & private storage bucket
DATA_MODE=local

# --- AI Vision Model ---
# Leave empty for bundled offline Demo Mode; provide a key for live inspection analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase Server-Side Admin Config (DATA_MODE=supabase only) ---
SUPABASE_URL=                          # e.g., https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=             # SENSITIVE: Admin service-role key (NEVER share with client!)
SUPABASE_STORAGE_BUCKET=inspection-media

# --- Media Upload & Ingestion Constraints ---
MAX_IMAGE_MB=10                        # Maximum image size (MB)
MAX_VIDEO_MB=50                        # Maximum video size (MB)
MAX_VIDEO_SECONDS=60                   # Maximum video duration (seconds)

# --- Pluggable Specialized Detector ---
DETECTOR_MODEL_PATH=                   # Optional local ONNX model weights path


# ==============================================================================================
# 🟢 FRONTEND CLIENT ONLY (client/) — PUBLIC & BROWSER-SAFE
# ==============================================================================================
# Only variables prefixed with VITE_ are visible to client/src code.

# --- Backend API Endpoint ---
VITE_API_BASE_URL=http://localhost:5000

# --- Supabase Public Client (DATA_MODE=supabase only) ---
# Safe for browser: anonymous key restricted by PostgreSQL Row Level Security (RLS)
VITE_SUPABASE_URL=                     # e.g., https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=                # Public anon key only
