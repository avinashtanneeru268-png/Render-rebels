# =================================================================
# 🔵 BACKEND SERVER ENVIRONMENT CONFIGURATION (server/.env)
# =================================================================
# CRITICAL SECURITY RULE:
# These variables are strictly for the Node.js/Express server.
# NEVER import or bundle these in the frontend client.
# =================================================================

# --- Network & Server Runtime ---
PORT=5000                              # Port Express listens on
NODE_ENV=development                   # development | production | test
CLIENT_URL=http://localhost:5173       # Allowed CORS origin for frontend

# --- Storage & Database Persistence Mode ---
DATA_MODE=local                        # "local" (zero-config SQLite/JSON store) or "supabase" (cloud PostgreSQL)

# --- Google Gemini Vision AI API ---
# Optional in Demo Mode; required for live inspection analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase Production Credentials (SERVER ONLY) ---
# Only needed when DATA_MODE=supabase
SUPABASE_URL=                          # e.g., https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=             # SENSITIVE: Admin service-role key (NEVER share with client!)
SUPABASE_STORAGE_BUCKET=inspection-media

# --- Ingestion & Preprocessing Limits ---
MAX_IMAGE_MB=10                        # Max file size for uploaded images
MAX_VIDEO_MB=50                        # Max file size for uploaded videos
MAX_VIDEO_SECONDS=60                   # Max video duration limit

# --- Optional Local Specialized Detector ---
DETECTOR_MODEL_PATH=                   # Optional local path to ONNX model weights
