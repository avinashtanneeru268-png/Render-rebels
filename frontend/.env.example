# =================================================================
# 🟢 FRONTEND CLIENT ENVIRONMENT CONFIGURATION (client/.env)
# =================================================================
# SAFETY & BROWSER RULES:
# - Only variables prefixed with VITE_ are exposed to the browser.
# - DO NOT put private API keys or service role secrets here!
# - Everything in this file is compiled into the public JavaScript bundle.
# =================================================================

# --- Backend API Connection ---
# URL of the SiteSentinel Express backend API server
VITE_API_BASE_URL=http://localhost:5000

# --- Supabase Public Client Credentials (SUPABASE MODE ONLY) ---
# In "local" demo mode, these can be left completely blank.
# In "supabase" production mode, provide ONLY the public anon key.
VITE_SUPABASE_URL=                     # e.g., https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=                # Public anonymous key (safe for browser)
